      <aliases enabled='yes' />
      <column caption='D2 AddressLine1' datatype='string' name='[AddressLine1]' role='dimension' type='nominal' />
      <column caption='D2 AddressLine2' datatype='string' name='[AddressLine2]' role='dimension' type='nominal' />
      <column caption='D2 Birth Date' datatype='date' name='[BirthDate]' role='dimension' type='ordinal' />
      <column datatype='real' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([SalesAmount]), -5, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation3 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([OrderDate]) = [Parameters].[Parameter 1154232092340253] - 1 THEN&#13;&#10;    [SalesAmount]&#13;&#10;END' />
      </column>
      <column datatype='real' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([SalesAmount]))'>
          <table-calc level-break='[federated.03nzz6b0d4kb6918ijm291xngm3k].[qr:OrderDate:ok]' ordering-field='[federated.03nzz6b0d4kb6918ijm291xngm3k].[OrderDate]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_0903268069265408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SalesAmount] - [TotalProductCost]' />
      </column>
      <column caption='% Margin' datatype='real' name='[Calculation_0903268069453825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_0903268069265408]) / sum([SalesAmount])' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_0903268076920834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([SalesAmount]),-1,1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Quantity Orders' datatype='integer' name='[Calculation_0903268085489668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([SalesOrderNumber])' />
      </column>
      <column caption='Aveg Ticket' datatype='real' name='[Calculation_0903268085764101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SalesAmount])/[Calculation_0903268085489668]' />
      </column>
      <column caption='Subset Labels' datatype='string' name='[Calculation_0903268109037580]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Top Products By Sales]&#13;&#10;THEN &quot;Top &quot; + str([Parameters].[Parameter 0903268092485640]) + &quot; Products&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
      </column>
      <column caption='Product Name Calc' datatype='string' name='[Calculation_0903268113297422]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0903268112654349]=&quot;Collapse&quot; THEN&#13;&#10;    IF [Top Products By Sales]&#13;&#10;        THEN [EnglishProductName]&#13;&#10;    ELSE &quot;Others&quot; END&#13;&#10;ELSE [EnglishProductName] END' />
      </column>
      <column caption='Measure Selected' datatype='real' name='[Calculation_0903268116652049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0903268116181008] WHEN &apos;Sales&apos; THEN SUM([SalesAmount])&#13;&#10;WHEN &apos;Quantity&apos; THEN [Calculation_0903268085489668]&#13;&#10;WHEN &apos;Profit&apos; THEN sum([Calculation_0903268069265408]) END' />
      </column>
      <column caption='YTD' datatype='real' name='[Calculation_1154232016576512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([SalesAmount]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last Period' datatype='real' name='[Calculation_1154232020381699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(sum([SalesAmount]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='num' datatype='real' name='[Calculation_1154232045072388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([SalesAmount]) - LOOKUP(sum([SalesAmount]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales Previous Year' datatype='real' name='[Calculation_1154232092082204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([OrderDate]) = [Parameters].[Parameter 1154232092340253] - 1 THEN [SalesAmount] END' />
      </column>
      <column caption='Filtro Año Actual/Anterior' datatype='boolean' name='[Calculation_1154232097095710]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([OrderDate]) &gt;= [Parameters].[Parameter 1154232092340253] - 1&#13;&#10;AND YEAR([OrderDate]) &lt;= [Parameters].[Parameter 1154232092340253]' />
      </column>
      <column caption='PositivoNegativo' datatype='string' name='[Calculation_1161104698048519]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [num (copy)_1154232057454598] &lt; 0 THEN&#13;&#10;    &quot;Negativo&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Positivo&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
