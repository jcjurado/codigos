          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Año' datatype='integer' name='[Parameter 1154232092340253]' param-domain-type='range' role='measure' type='quantitative' value='2013'>
              <calculation class='tableau' formula='2013' />
              <range granularity='1' max='2014' min='2010' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03nzz6b0d4kb6918ijm291xngm3k'>
            <column caption='Filtro Año Actual/Anterior' datatype='boolean' name='[Calculation_1154232097095710]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([OrderDate]) &gt;= [Parameters].[Parameter 1154232092340253] - 1&#13;&#10;AND YEAR([OrderDate]) &lt;= [Parameters].[Parameter 1154232092340253]' />
            </column>
            <column caption='PositivoNegativo' datatype='string' name='[Calculation_1161104698048519]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [num (copy)_1154232057454598] &lt; 0 THEN&#13;&#10;    &quot;Negativo&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Positivo&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='F1 Order Date' datatype='date' name='[OrderDate]' role='dimension' type='ordinal' />
            <column caption='F1 Sales Amount' datatype='real' name='[SalesAmount]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1154232097095710]' derivation='None' name='[none:Calculation_1154232097095710:nk]' pivot='key' type='nominal' />
            <column caption='%YoY' datatype='real' name='[num (copy)_1154232057454598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([SalesAmount]) - LOOKUP(sum([SalesAmount]),-1) )/ abs(LOOKUP(sum([SalesAmount]),-1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[Calculation_1161104698048519]' derivation='User' name='[usr:Calculation_1161104698048519:nk:2]' pivot='key' type='nominal'>
