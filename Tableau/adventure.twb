            <column caption='Subset Labels' datatype='string' name='[Calculation_0903268109037580]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Top Products By Sales]&#13;&#10;THEN &quot;Top &quot; + str([Parameters].[Parameter 0903268092485640]) + &quot; Products&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
            </column>
            <column caption='Product Name Calc' datatype='string' name='[Calculation_0903268113297422]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 0903268112654349]=&quot;Collapse&quot; THEN&#13;&#10;    IF [Top Products By Sales]&#13;&#10;        THEN [EnglishProductName]&#13;&#10;    ELSE &quot;Others&quot; END&#13;&#10;ELSE [EnglishProductName] END' />
            </column>
            <column caption='Measure Selected' datatype='real' name='[Calculation_0903268116652049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0903268116181008] WHEN &apos;Sales&apos; THEN SUM([SalesAmount])&#13;&#10;WHEN &apos;Quantity&apos; THEN [Calculation_0903268085489668]&#13;&#10;WHEN &apos;Profit&apos; THEN sum([Calculation_0903268069265408]) END' />
